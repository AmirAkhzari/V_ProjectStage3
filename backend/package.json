{
  "name": "@vproject/backend",
  "version": "0.0.0",
  "private": true,
  "description": "V-Project backend — P0 Foundation skeleton (modular monolith)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start:api": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run lint:eslint && pnpm run lint:format && pnpm run lint:deps && pnpm run lint:structure",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:format": "prettier --check .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:structure": "node scripts/check-structure.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "db:drift": "node scripts/check-drift.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "drizzle-kit check",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "contract:verify": "node scripts/verify-contract.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
