NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# Each process loads only its own URL. Do not set MIGRATION_DATABASE_URL on the API or worker in production.
MIGRATION_DATABASE_URL=postgres://vproject:vproject@127.0.0.1:5432/vproject
DATABASE_URL_APP=postgres://vproject_app:vproject@127.0.0.1:5432/vproject
DATABASE_URL_WORKER=postgres://vproject_worker:vproject@127.0.0.1:5432/vproject
DATABASE_URL_IDENTITY=postgres://vproject_identity:vproject@127.0.0.1:5432/vproject
REDIS_URL=redis://127.0.0.1:6379
HEALTH_CHECK_TIMEOUT_MS=1000
WORKER_POLL_INTERVAL_MS=1000
OUTBOX_LAG_THRESHOLD_MS=30000
READY_RETRY_AFTER_SECONDS=5
OPENAPI_DOCS_ENABLED=false
LOCAL_ROLE_PASSWORD=vproject
