NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# API holds DATABASE_URL_APP + DATABASE_URL_IDENTITY. Worker holds DATABASE_URL_WORKER only.
# Do not set MIGRATION_DATABASE_URL or DATABASE_URL_WORKER on the API in production.
MIGRATION_DATABASE_URL=postgres://vproject:vproject@127.0.0.1:5432/vproject
DATABASE_URL_APP=postgres://vproject_app:vproject@127.0.0.1:5432/vproject
DATABASE_URL_WORKER=postgres://vproject_worker:vproject@127.0.0.1:5432/vproject
DATABASE_URL_IDENTITY=postgres://vproject_identity:vproject@127.0.0.1:5432/vproject
# Limiter + session deny assume a single-node Redis (no Cluster hash slots).
REDIS_URL=redis://127.0.0.1:6379
HEALTH_CHECK_TIMEOUT_MS=1000
WORKER_POLL_INTERVAL_MS=1000
OUTBOX_LAG_THRESHOLD_MS=30000
READY_RETRY_AFTER_SECONDS=5
OPENAPI_DOCS_ENABLED=false
# Production: required. The API port is reachable only through the LB; do not expose it.
# 0 = ignore X-Forwarded-For. 1 = trust the last hop (the load balancer).
TRUST_PROXY_HOPS=0
# Production: required. HMAC-SHA256 key (≥32 bytes). Rejects this example and the test fixture.
AUDIT_HASH_KEY=change-me-to-a-32-byte-or-longer-secret
LOCAL_ROLE_PASSWORD=vproject
# S11b-2 EdDSA keyset (secret manager). Required when S11b-3 wires the auth plugin.
# JWT_ISS=vproject
# JWT_EDDSA_ACTIVE_KID=
# JWT_EDDSA_JWKS=
# SMS: fake is local/CI only. Production refuses fake and requires key + approved template.
SMS_PROVIDER=fake
# Default-off live send (P14-1). Production requires true unless SMS_STAGING_ALLOW_DISABLED=true.
SMS_LIVE_SEND=false
# SMS_STAGING_ALLOW_DISABLED=false
# KAVENEGAR_API_KEY=
# Template: ^[A-Za-z][A-Za-z0-9_-]{1,63}$ (approved lookup name, server-owned).
# KAVENEGAR_TEMPLATE=
# SMS_TIMEOUT_MS=4000
# Production requires SMS_BUDGET_HOUR + SMS_BUDGET_DAY (fail closed; no unlimited default). Amir sets values.
# SMS_BUDGET_HOUR=
# SMS_BUDGET_DAY=
# SMS_SPIKE_BASELINE_HOUR=
# OTP pepper (≥32 bytes). Production rejects the example value.
OTP_HMAC_KEY=change-me-to-a-32-byte-otp-pepper
